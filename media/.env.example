# Secreto compartido con el Worker (wrangler secret put MEDIA_SECRET). Mínimo 32 caracteres.
MEDIA_SECRET=
# Token del túnel de Cloudflare que publica este servicio.
TUNNEL_TOKEN=
# Opcionales
# MAX_IMAGE_MB=15
# MAX_VIDEO_MB=95
# IMAGE_TTL_DAYS=30
# VIDEO_TTL_DAYS=7
# MAX_DISK_GB=20
# Dueño de la carpeta data en el servidor.
# MEDIA_UID=1000
# MEDIA_GID=1000
