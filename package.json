{
  "name": "shrt",
  "version": "0.1.0",
  "private": true,
  "description": "Acortador de links shrt.emky.com.mx — Cloudflare Workers + D1",
  "scripts": {
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "dev": "npm run web:build && wrangler dev",
    "build": "npm run web:build",
    "deploy": "npm run web:build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply shrt --local",
    "db:migrate": "wrangler d1 migrations apply shrt --remote",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250601.0",
    "preact": "^10.25.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "@preact/preset-vite": "^2.9.4",
    "wrangler": "^4.101.0"
  }
}
